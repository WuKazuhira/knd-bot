# 复制为 .env 后按需填写。所有秘密只放在 .env（已被 git 忽略），不要提交。
# 容器会以只读方式挂载本文件对应的 .env，NoneBot 直接从中读取下列配置。

# ===== NoneBot 基础 =====
HOST=0.0.0.0
PORT=8081
SUPERUSERS=["123456789"]
SESSION_EXPIRE_TIMEOUT=00:01:00
TZ=Asia/Shanghai
# 命令前缀，空串表示允许无前缀触发
COMMAND_START=["", "/", "."]
# 呼叫机器人的昵称，用于判断“对我说话”
NICKNAME=["小七"]
SESSION_RUNNING_EXPRESSION="别急呀,还在处理上一条呢!"

# 机器人展示信息
BOT_DISPLAY_NAME=小七
BOT_URL=

# 多机器人账号（可选，未配置时留空；用于多号同群去重）
MAIN_BOT_QQ=
SUB_BOT_QQ=
AUX_BOT_QQ=
EXT_BOT_QQ=
FIF_BOT_QQ=

# ===== 数据库（必填其一：DATABASE_URL 或 DB_* 组合） =====
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=kndbot
DB_PASSWORD=change-me
DB_NAME=kndbot
# DATABASE_URL=postgresql://kndbot:change-me@127.0.0.1:5432/kndbot

# Docker Compose 使用的 Postgres 初始化变量（与上方保持一致）
POSTGRES_USER=kndbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kndbot

# chromium 边车对外暴露的宿主端口（容器内 kndbot 仍监听 8081）
KND_PORT=18081

# ===== 路径覆盖（一般无需修改） =====
# KNDBOT_CONFIG_DIR=
# KNDBOT_DATA_DIR=
# KNDBOT_RESOURCE_DIR=
# KNDBOT_LOG_DIR=
# KNDBOT_TEMP_DIR=
# KNDBOT_LOCAL_CONFIG_DIR=  # chat/ 与 llm/ 所在的配置根目录，默认使用 config/

# ===== 代理（可选） =====
SYSTEM_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,kndbot,chromium,kndbot-chromium,host.docker.internal
# 构建期代理（可选）
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_ALL_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1,postgres,kndbot,chromium,kndbot-chromium,host.docker.internal

# ===== PJSK 相关 =====
# 需要鉴权的游戏 API token（可选，留空则相关功能降级/禁用）
GAMEAPI_TOKEN=
# 外部 Haruki 绘图 / 组卡服务地址（可选，逗号分隔多个）
HARUKI_DRAWING_API_URLS=
HARUKI_DECK_SERVICE_URLS=
# 组卡服务
DECK_SERVICE_PORT=45557
DECK_SERVICE_URLS=http://127.0.0.1:45557
DECK_BACKENDS=http
DECK_SERVICE_RUST_LOG=deck_service=info
DECK_RECOMMENDER_REGIONS=
DECK_RECOMMENDER_REFRESH_INTERVAL=
# 谷歌表代理（可选）
PJSK_GOOGLE_SHEET_PROXY=

# ===== 聊天/LLM =====
AUTOCHAT_RPC_TOKEN=
# AUTOCHAT_CONFIG_PATH=
# CHAT_SYSTEM_PROMPT_PATH=
