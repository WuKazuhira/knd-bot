# 复制为 .env 后按需填写（容器内只读挂载）

# NoneBot 基础
HOST=0.0.0.0
PORT=8081
SUPERUSERS=["123456789"]
SESSION_EXPIRE_TIMEOUT=00:01:00
TZ=Asia/Shanghai
# 命令前缀，空串表示允许无前缀触发
COMMAND_START=["", "/", "."]
# 机器人昵称
NICKNAME=["小七"]
SESSION_RUNNING_EXPRESSION="别急呀,还在处理上一条呢!"

# OneBot v11 鉴权 token（与 OneBotFilter 保持一致）
ONEBOT_ACCESS_TOKEN=
# OneBot HTTP 上报签名密钥
ONEBOT_SECRET=
# 是否允许管理命令执行 SQL（默认关）
KNDBOT_ENABLE_EXEC_SQL=0

# 机器人展示信息
BOT_DISPLAY_NAME=小七
BOT_URL=

# 多号同群去重用（可选）
MAIN_BOT_QQ=
SUB_BOT_QQ=
AUX_BOT_QQ=
EXT_BOT_QQ=
FIF_BOT_QQ=

# 数据库（填 DB_* 或 DATABASE_URL 任一）
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=kndbot
DB_PASSWORD=change-me
DB_NAME=kndbot
# DATABASE_URL=postgresql://kndbot:change-me@127.0.0.1:5432/kndbot

# Postgres 容器初始化配置（与上面保持一致）
POSTGRES_USER=kndbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kndbot

# 容器运行 UID/GID（非 root 需先 chown 宿主持久化目录）
KND_UID=1000
KND_GID=1000

# 宿主机映射端口（容器内固定 8081）
KND_PORT=18081

# 容器/镜像命名（同机多实例时修改）
# KND_PROJECT=kndbot
# KND_PREFIX=kndbot
# KND_IMAGE=kndbot:local
# KND_CHROMIUM_IMAGE=kndbot-chromium:local
KND_PJSK_DRAW_IMAGE=kndbot-pjsk-draw:local

# 路径覆盖（一般不用改）
# KNDBOT_CONFIG_DIR=
# KNDBOT_DATA_DIR=
# KNDBOT_RESOURCE_DIR=
# KNDBOT_LOG_DIR=
# KNDBOT_TEMP_DIR=
# KNDBOT_LOCAL_CONFIG_DIR=  # chat/llm 配置目录，默认 config/

# 代理（可选）
SYSTEM_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,kndbot,chromium,kndbot-chromium,pjsk-helper,pjsk-draw,allium-deck-server,deck-recommender,host.docker.internal
# 构建期代理（可选）
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_ALL_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1,postgres,kndbot,chromium,kndbot-chromium,pjsk-helper,pjsk-draw,allium-deck-server,deck-recommender,host.docker.internal

# PJSK 相关
# 默认 PJSK 指令走 Go 服务，Python 不加载 plugins.pjsk
KNDBOT_PJSK_RUNTIME=go
PJSKBOT_STANDALONE=1
PJSKBOT_ONEBOT_MODE=reverse
PJSKBOT_ONEBOT_LISTEN_ADDR=:3001
PJSKBOT_ONEBOT_PATH=/onebot/v11/ws
# Go 反向 WS 鉴权 token（与 OneBotFilter 一致）
PJSKBOT_ONEBOT_TOKEN=
PJSKBOT_ALLOW_UNAUTHENTICATED_ONEBOT=0
# 共享的群开关/黑名单文件路径
PJSKBOT_GROUP_MANAGER_PATH=/app/data/manager/group_manager.json
# 设为 1 记录所有普通消息日志
PJSKBOT_LOG_MESSAGES=0
# 游戏 API 鉴权 token（可选）
GAMEAPI_TOKEN=
# PJSK 微服务地址（Compose 默认一般不用改）
PJSK_DRAW_SERVICE_URL=http://pjsk-draw:45560
PJSK_DRAW_SERVICE_URLS=http://pjsk-draw:45560
# 需大于绘图服务下载资源超时（默认 90s）
PJSK_DRAW_REQUEST_TIMEOUT=150s
PJSK_HELPER_URL=http://pjsk-helper:8000
# skme 查 remote_live 个人历史用的默认账号和区服
SEKAI_REMOTE_ACCOUNT=
SEKAI_REMOTE_REGION=cn
# 内部服务本机回环端口（仅本机调试用）
PJSK_HELPER_PORT=45558
PJSK_DRAW_PORT=45560
DECK_RECOMMENDER_PORT=45557
# 外部 Haruki 绘图地址（可选，逗号分隔）
HARUKI_DRAWING_API_URLS=
# 组卡后端：allium（默认）/ http / both
DECK_BACKENDS=allium
# 可选 profile：deck-http
COMPOSE_PROFILES=
# 组卡 HTTP 服务地址（逗号分隔，启用 http/both 必填，Compose 内填 http://allium-deck-server:45557）
DECK_SERVICE_URLS=
# 组卡 API 版本：v1（默认），legacy/auto 仅兼容旧版
DECK_SERVICE_API=v1
DECK_SERVICE_HTTP_TIMEOUT=120
# allium-deck 服务参数
ALLIUM_DECK_IMAGE=kndbot-allium-deck:local
ALLIUM_DECK_WORKERS=2
ALLIUM_DECK_MAX_QUEUE=16
ALLIUM_DECK_MAX_SEARCH_TIMEOUT_MS=30000
# PJSK 数据和榜线采集默认走 Go sidecar
PJSK_MASTERDATA_AGENT=go
PJSK_SUITE_BACKEND=go
PJSK_ASSET_AGENT=go
PJSK_RANKING_COLLECTOR=go
PJSK_HELPER_RANKING_COLLECT=1
RANKING_COLLECT_INTERVAL=1s
# 谷歌表代理（可选）
PJSK_GOOGLE_SHEET_PROXY=
# 宿主机 PJSK 外部数据目录（3D 渲染与本地日服主数据）
HARUKI_3D_RUNTIME_HOST_DIR=./volumes/haruki-3d-output
LOCAL_JP_DATA_HOST_DIR=./volumes/local-jp

# 表情包（meme-generator）
# 素材约 400MB 存在 data/meme_generator，首次走 jsdelivr 拉取可填代理加速
# MEME_DOWNLOAD_PROXY=http://host.docker.internal:7890
MEME_DOWNLOAD_PROXY=
# 设为 0 跳过启动时素材校验
MEME_CHECK_RESOURCES=1

# 聊天/LLM
AUTOCHAT_RPC_TOKEN=
# AUTOCHAT_CONFIG_PATH=
# CHAT_SYSTEM_PROMPT_PATH=

# AI 海龟汤
# 出题模型（本地题库模式可留空）
ATS_OPENAI_GENERATE_API_KEY=
ATS_OPENAI_GENERATE_BASE_URL=https://api-inference.modelscope.cn/v1
ATS_OPENAI_GENERATE_MODEL=ZhipuAI/GLM-4.5
# 裁判模型（必填）
ATS_OPENAI_JUDGE_API_KEY=
ATS_OPENAI_JUDGE_BASE_URL=https://openrouter.ai/api/v1
ATS_OPENAI_JUDGE_MODEL=x-ai/grok-4-fast
# 题库来源：ai（模型出题）或 local（本地题库）
ATS_PUZZLE_SOURCE=ai
# 本地题库 JSON 路径（Docker 可放 ./data/turtle_soup/）
ATS_LOCAL_PUZZLES_PATH=
# ATS_LOCAL_PUZZLES_PATH=/app/data/turtle_soup/puzzles.json
ATS_MAX_QUESTIONS=50
ATS_TIMEOUT=7200
