# 复制为 .env 后按需填写。
# 容器会以只读方式挂载本文件对应的 .env，NoneBot 直接从中读取下列配置。

# ===== NoneBot 基础 =====
HOST=0.0.0.0
PORT=8081
SUPERUSERS=["123456789"]
SESSION_EXPIRE_TIMEOUT=00:01:00
TZ=Asia/Shanghai
# 命令前缀，空串表示允许无前缀触发
COMMAND_START=["", "/", "."]
# 呼叫机器人的昵称，用于判断“对我说话”
NICKNAME=["小七"]
SESSION_RUNNING_EXPRESSION="别急呀,还在处理上一条呢!"

# 机器人展示信息
BOT_DISPLAY_NAME=小七
BOT_URL=

# 多机器人账号（可选，未配置时留空；用于多号同群去重）
MAIN_BOT_QQ=
SUB_BOT_QQ=
AUX_BOT_QQ=
EXT_BOT_QQ=
FIF_BOT_QQ=

# ===== 数据库（必填其一：DATABASE_URL 或 DB_* 组合） =====
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=kndbot
DB_PASSWORD=change-me
DB_NAME=kndbot
# DATABASE_URL=postgresql://kndbot:change-me@127.0.0.1:5432/kndbot

# Docker Compose 使用的 Postgres 初始化变量（与上方保持一致）
POSTGRES_USER=kndbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kndbot

# chromium 边车对外暴露的宿主端口（容器内 kndbot 仍监听 8081）
KND_PORT=18081

# ===== 命名（一般无需修改）=====
# 默认就是线上一直在用的那组名字。宿主上若还留着同名的旧副本目录，
# 在那边 build/up 会顶掉本项目的容器并覆盖 kndbot:local 镜像——
# 要让两套并存，就在这里改成不同的名字和端口。
# KND_PROJECT=kndbot
# KND_PREFIX=kndbot
# KND_IMAGE=kndbot:local
# KND_CHROMIUM_IMAGE=kndbot-chromium:local
# 私有 sekai-api 源码不随公开仓库分发；新机器需指定预构建镜像或先 docker load。
KND_SEKAI_API_IMAGE=kndbot-sekai-api:local

# ===== 路径覆盖（一般无需修改） =====
# KNDBOT_CONFIG_DIR=
# KNDBOT_DATA_DIR=
# KNDBOT_RESOURCE_DIR=
# KNDBOT_LOG_DIR=
# KNDBOT_TEMP_DIR=
# KNDBOT_LOCAL_CONFIG_DIR=  # chat/ 与 llm/ 所在的配置根目录，默认使用 config/

# ===== 代理（可选） =====
SYSTEM_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,kndbot,chromium,kndbot-chromium,pjsk-helper,pjsk-draw,sekai-api,allium-deck-server,deck-recommender,host.docker.internal
# 构建期代理（可选）
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_ALL_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1,postgres,kndbot,chromium,kndbot-chromium,pjsk-helper,pjsk-draw,sekai-api,allium-deck-server,deck-recommender,host.docker.internal

# ===== PJSK 相关 =====
# 生产默认：PJSK 指令由常驻 Go 服务处理，Python 主进程不加载 plugins.pjsk。
KNDBOT_PJSK_RUNTIME=go
PJSKBOT_STANDALONE=1
PJSKBOT_ONEBOT_MODE=reverse
PJSKBOT_ONEBOT_LISTEN_ADDR=:3001
PJSKBOT_ONEBOT_PATH=/onebot/v11/ws
# 默认只记录命中/疑似命令；设为 1 可额外记录普通未命中消息的截断文本。
PJSKBOT_LOG_MESSAGES=0
# 需要鉴权的游戏 API token（可选，留空则相关功能降级/禁用）
GAMEAPI_TOKEN=
# Go PJSK 依赖的独立服务地址（Compose 默认值通常无需修改）
PJSK_DRAW_SERVICE_URL=http://pjsk-draw:45560
# Python 绘图客户端使用复数变量，默认与 Go 指向同一服务。
PJSK_DRAW_SERVICE_URLS=http://pjsk-draw:45560
# Go→draw 总预算需大于 draw→helper 的资源下载预算（默认 90 秒）。
PJSK_DRAW_REQUEST_TIMEOUT=150s
PJSK_HELPER_URL=http://pjsk-helper:8000
SEKAI_API_URL=http://sekai-api:9999
# 内部服务仅绑定宿主回环地址；这些端口用于本机诊断，不应直接暴露公网。
PJSK_HELPER_PORT=45558
PJSK_DRAW_PORT=45560
SEKAI_API_PORT=9999
DECK_RECOMMENDER_PORT=45557
# sekai-api 服务端 JWT secret 与调用 token。部署前必须替换 secret 占位值。
SEKAI_API_JWT_SECRET=replace-with-a-long-random-secret
SEKAI_API_TOKEN=
# 外部 Haruki 绘图服务地址（可选，逗号分隔多个）
HARUKI_DRAWING_API_URLS=
# Allium 组卡后端：allium（默认）、http 或 both。
DECK_BACKENDS=allium
# 使用 http/both 时必须启用 deck-http profile：COMPOSE_PROFILES=deck-http
COMPOSE_PROFILES=
# 上游 allium-deck/server 地址（Compose 内推荐 http://allium-deck-server:45557）。
# 多个地址用逗号分隔；启用 http/both 时必须填写。
DECK_SERVICE_URLS=
# v1 为上游 server API；legacy/auto 仅兼容旧 JSON /recommend 服务。
DECK_SERVICE_API=v1
DECK_SERVICE_HTTP_TIMEOUT=120
# 上游 allium-deck/server 镜像与运行参数。
ALLIUM_DECK_IMAGE=kndbot-allium-deck:local
ALLIUM_DECK_WORKERS=2
ALLIUM_DECK_MAX_QUEUE=16
ALLIUM_DECK_MAX_SEARCH_TIMEOUT_MS=30000
# PJSK 数据代理与榜线采集默认走 Go sidecar。
PJSK_MASTERDATA_AGENT=go
PJSK_SUITE_BACKEND=go
PJSK_ASSET_AGENT=go
PJSK_RANKING_COLLECTOR=go
PJSK_HELPER_RANKING_COLLECT=1
RANKING_COLLECT_INTERVAL=1s
# 谷歌表代理（可选）
PJSK_GOOGLE_SHEET_PROXY=

# ===== 表情包（meme-generator）=====
# 素材约 400MB，持久化在 data/meme_generator（由 compose 注入 MEME_HOME）。
# 首次拉取走 jsdelivr，国内直连很慢；填代理可显著加速，例如宿主机上的 clash：
# MEME_DOWNLOAD_PROXY=http://host.docker.internal:7890
MEME_DOWNLOAD_PROXY=
# 设为 0 可跳过启动时的素材校验（素材已就绪且想省那几秒时用）
MEME_CHECK_RESOURCES=1

# ===== 聊天/LLM =====
AUTOCHAT_RPC_TOKEN=
# AUTOCHAT_CONFIG_PATH=
# CHAT_SYSTEM_PROMPT_PATH=

# ===== AI 海龟汤 =====
# 密钥只填写在本地 .env 中，不要提交真实密钥。
# AI 出题模型；使用本地题库模式时可以留空。
ATS_OPENAI_GENERATE_API_KEY=
ATS_OPENAI_GENERATE_BASE_URL=https://api-inference.modelscope.cn/v1
ATS_OPENAI_GENERATE_MODEL=ZhipuAI/GLM-4.5
# 游戏主持、问题判断及进度计算模型（必填）。
ATS_OPENAI_JUDGE_API_KEY=
ATS_OPENAI_JUDGE_BASE_URL=https://openrouter.ai/api/v1
ATS_OPENAI_JUDGE_MODEL=x-ai/grok-4-fast
# ai：由模型生成题目；local：从本地 JSON 题库随机选题。
ATS_PUZZLE_SOURCE=ai
# Docker 部署可将题库放到 ./data/turtle_soup/，并填写容器内路径。
ATS_LOCAL_PUZZLES_PATH=
# ATS_LOCAL_PUZZLES_PATH=/app/data/turtle_soup/puzzles.json
ATS_MAX_QUESTIONS=50
ATS_TIMEOUT=7200
