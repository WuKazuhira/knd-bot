{
  "type": "record",
  "name": "MysekaiHarvestMapsProjection",
  "namespace": "knd.pjsk",
  "doc": "Custom AVSC projection for the captured MySekai compact subtree. Dict objects use string msgpack_key values; compact array records use integer msgpack_key positions. Field names/types are cross-checked against Haruki-Sekai-API Nuverse schema bundle.",
  "fields": [
    {
      "name": "updatedResources",
      "type": {
        "type": "record",
        "name": "MysekaiUpdatedResources",
        "namespace": "knd.pjsk",
        "doc": "The updatedResources object in the decrypted response; string MessagePack map keys.",
        "fields": [
          {
            "name": "userMysekaiHarvestMaps",
            "type": {
              "type": "array",
              "items": {
                "type": "record",
                "name": "UserMysekaiHarvestMap",
                "namespace": "Sekai.ApiData",
                "doc": "Captured compact map row order; names/types checked against upstream Nuverse schema.",
                "fields": [
                  {
                    "name": "mysekaiSiteId",
                    "type": "int",
                    "msgpack_key": 0,
                    "doc": "Compact row slot 0; checked against the captured site IDs."
                  },
                  {
                    "name": "userMysekaiSiteHarvestFixtures",
                    "type": {
                      "type": "array",
                      "items": {
                        "type": "record",
                        "name": "UserMysekaiSiteHarvestFixture",
                        "namespace": "Sekai.ApiData",
                        "doc": "Captured compact positional order, with names/types checked against the upstream Nuverse schema.",
                        "fields": [
                          {
                            "name": "mysekaiSiteHarvestFixtureId",
                            "type": "int",
                            "msgpack_key": 0,
                            "doc": "Slot 0; field name/type cross-checked against the Nuverse UserMysekaiSiteHarvestFixture schema."
                          },
                          {
                            "name": "positionX",
                            "type": "int",
                            "msgpack_key": 1,
                            "doc": "Slot 1; field name/type cross-checked against the Nuverse schema."
                          },
                          {
                            "name": "positionZ",
                            "type": "int",
                            "msgpack_key": 2,
                            "doc": "Slot 2; field name/type cross-checked against the Nuverse schema."
                          },
                          {
                            "name": "hp",
                            "type": "int",
                            "msgpack_key": 3,
                            "doc": "Slot 3; observed values 0 or 90; field name/type cross-checked against the Nuverse schema."
                          },
                          {
                            "name": "userMysekaiSiteHarvestFixtureStatus",
                            "type": "string",
                            "msgpack_key": 4,
                            "doc": "Slot 4; observed spawned; field name/type cross-checked against the Nuverse schema."
                          },
                          {
                            "name": "mysekaiSiteHarvestSpawnLimitedRelationGroupId",
                            "type": [
                              "null",
                              "int"
                            ],
                            "msgpack_key": 5,
                            "doc": "Slot 5; null in this capture; field name/type cross-checked against the Nuverse schema; nullable union accommodates observed nil."
                          }
                        ]
                      }
                    },
                    "msgpack_key": 1,
                    "doc": "Compact map row slot 1; list of positional fixture rows."
                  },
                  {
                    "name": "userMysekaiSiteHarvestResourceDrops",
                    "type": {
                      "type": "array",
                      "items": {
                        "type": "record",
                        "name": "UserMysekaiSiteHarvestResourceDrop",
                        "namespace": "Sekai.ApiData",
                        "doc": "Captured compact positional order, with names/types checked against the upstream Nuverse schema.",
                        "fields": [
                          {
                            "name": "resourceType",
                            "type": "string",
                            "msgpack_key": 0,
                            "doc": "Slot 0; field name/type cross-checked against the Nuverse schema."
                          },
                          {
                            "name": "resourceId",
                            "type": "int",
                            "msgpack_key": 1,
                            "doc": "Slot 1; field name/type cross-checked against the Nuverse schema."
                          },
                          {
                            "name": "positionX",
                            "type": "int",
                            "msgpack_key": 2,
                            "doc": "Slot 2; field name/type cross-checked against the Nuverse schema."
                          },
                          {
                            "name": "positionZ",
                            "type": "int",
                            "msgpack_key": 3,
                            "doc": "Slot 3; field name/type cross-checked against the Nuverse schema."
                          },
                          {
                            "name": "quantity",
                            "type": "int",
                            "msgpack_key": 4,
                            "doc": "Slot 4; field name/type cross-checked against the Nuverse schema."
                          },
                          {
                            "name": "seq",
                            "type": "int",
                            "msgpack_key": 5,
                            "doc": "Slot 5; observed 1-based sequence per site list; field name/type cross-checked against the Nuverse schema."
                          },
                          {
                            "name": "mysekaiSiteHarvestResourceDropStatus",
                            "type": "string",
                            "msgpack_key": 6,
                            "doc": "Slot 6; observed before_drop; field name/type cross-checked against the Nuverse schema."
                          },
                          {
                            "name": "hp",
                            "type": "int",
                            "msgpack_key": 7,
                            "doc": "Slot 7; observed constant 1; field name/type cross-checked against the Nuverse schema."
                          },
                          {
                            "name": "mysekaiSiteHarvestSpawnLimitedRelationGroupId",
                            "type": [
                              "null",
                              "int"
                            ],
                            "msgpack_key": 8,
                            "doc": "Slot 8; null in this capture; field name/type cross-checked against the Nuverse schema; nullable union accommodates observed nil."
                          }
                        ]
                      }
                    },
                    "msgpack_key": 2,
                    "doc": "Compact map row slot 2; list of positional resource-drop rows."
                  }
                ]
              }
            },
            "msgpack_key": "userMysekaiHarvestMaps",
            "doc": "Map key in the decrypted response."
          }
        ]
      },
      "msgpack_key": "updatedResources",
      "doc": "String MessagePack map key in the decrypted response."
    }
  ]
}
